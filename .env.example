# Copy to .env in the repository root. .env is ignored by Git.
PORT=8876
# Local-only by default. A shared server needs an HTTPS reverse proxy.
# Set its exact origin, without path or credentials.
GROK_BIND_HOST=127.0.0.1
GROK_PUBLIC_ORIGIN=
# Preserve private runtime storage across restarts when hosting the server.
# HARNESS_DATA_DIR=/private/persistent/path/grok-runtime

# Independent Grok Bot inference. Direct xAI is the default provider.
GROK_MODEL_PROVIDER=xai
# Set an xAI API key and a model ID enabled for that account.
XAI_API_KEY=
XAI_MODEL=

# Optional authorized Claude-seat inference; the Grok host still owns all tools.
# Set GROK_MODEL_PROVIDER=claude-seat and the model enabled for your own seat.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_BINARY=/absolute/path/to/claude
# GROK_CLAUDE_SEAT_TOKEN_FILE=/private/path/to/seat-token

# GitHub Remote MCP requires your own registered OAuth App.
# Callback with the port above: http://127.0.0.1:8876/api/harness/oauth/callback
GROK_GITHUB_OAUTH_CLIENT_ID=
GROK_GITHUB_OAUTH_CLIENT_SECRET=

# Notion MCP uses public dynamic client registration; no shared client secret.
# Actual provider consent is completed in the browser from Accounts beheren.
